# ==============================================================================
# MASTER-LADESTEUERUNG: HELFER-PACKAGE (Vorlage)
#
# Diese Datei ist eine VORLAGE, kein fertiges Package. Vor dem Einsatz an
# einem Standort sind die mit <HIER EINTRAGEN> markierten Stellen anzupassen:
#
#   1. utility_meter.hausverbrauch_halbstuendlich.source
#        -> der Tageszaehler des Hausverbrauchs (kWh, steigend). Der Blueprint
#           nullt diesen Zaehler selbst alle 30 Minuten.
#   2. binary_sensor "Ladesteuerung Eingriff Aktiv"
#        -> die number-Entitaet des maximalen Ladestroms und deren Maximalwert
#           (derselbe Wert wie der Blueprint-Input "Maximaler Ladestrom").
#   3. Nur mit Wallbox: die Zaehler wallbox_N_halbstuendlich einkommentieren
#        und je Ladepunkt die Quelle eintragen (evcc "Charge Total Import").
#        Der offene Ladebedarf braucht keinen Helfer, die evcc-Sensoren
#        "Charge Remaining Energy" werden direkt ausgewaehlt.
#   4. Nur mit Notstromausgang: den Integrations-Sensor und den Zaehler
#        notstromlast_halbstuendlich einkommentieren und als Quelle die
#        Leistung am Load-UPS-Ausgang des Deye eintragen ("Load UPS Power", W).
#        Optionale Bloecke bleiben sonst auskommentiert stehen: ein
#        stehengebliebener Platzhalter verwirft die ganze Gruppe.
#
# Alles andere ist standortunabhaengig. Nach dem Einbinden ueber packages:
# sind die Entitaeten den Blueprint-Inputs zuzuweisen; die Zuordnung steht
# jeweils als Kommentar dabei.
#
# Das Schatten-BMS ist nicht mehr Teil der Ladesteuerung: Es rechnet den
# Ladestand aus den Lade-/Entladezaehlern und bringt Sensor, Helfer und
# Kalibrier-Automation selbst mit. Zugewiesen werden beide Werte getrennt: der
# Ladestand des Wechselrichters als "Ladezustand SOC (%)", der des Schatten-BMS
# in das optionale Feld darunter. Der Blueprint braucht beide, um die
# Entlade-Untergrenze in die Skala des Wechselrichters umzurechnen.
#
# Optional: Diagnose-Aufzeichnung. Existiert notify.pv_optimizer_aufzeichnung,
# schreibt der Blueprint JSON-Zeilen mit allen Eingangs- und Rechenwerten: je
# halbe Stunde (art: lauf), nach jedem Lauf, der etwas geschrieben hat (art:
# entscheidung), und je halbe Stunde den Slot-Verbrauch (art: slot). Die
# Kennung [Vx.y.z · HH:MM:SS] vorn in jeder Logbuch-Meldung steht als "kennung"
# in den Zeilen desselben Laufs. Ohne diese Entitaet passiert nichts, das
# Logbuch meldet das einmal taeglich. Sie laesst sich NICHT per
# YAML anlegen (die File-Integration kennt nur noch Config-Entries), sondern
# nur ueber die Oberflaeche:
#   1. In configuration.yaml das Zielverzeichnis freigeben:
#        homeassistant:
#          allowlist_external_dirs:
#            - /config/pv_optimizer
#      Danach Home Assistant neu starten und das Verzeichnis anlegen.
#   2. Einstellungen -> Geraete & Dienste -> Integration hinzufuegen -> "File"
#      -> Benachrichtigungsdienst, Dateipfad
#      /config/pv_optimizer/aufzeichnung.jsonl, Zeitstempel AUS.
#   3. Einstellungen -> Entitaeten -> die neue notify-Entitaet -> Zahnrad ->
#      Entitaets-ID auf notify.pv_optimizer_aufzeichnung aendern.
# NICHT nach /config/www: Alles darunter liefert Home Assistant unter /local/
# ohne Anmeldung aus, und die Datei beschreibt den Standort im Detail (ca.
# 0,7 MB je Tag). Holen per Samba, Datei-Editor oder scp; lokal nach
# tests/fixtures/ legen, dort per .gitignore vom Repo ausgeschlossen.
# ==============================================================================

input_boolean:
  batterie_heute_voll:                # -> Helfer: Batterie war heute voll
    name: "Batterie heute voll"
    icon: mdi:battery-check
  blockade_heute_beendet:             # -> Helfer: Morgen-Blockade heute beendet
    name: "Morgen-Blockade heute beendet"
    icon: mdi:weather-sunset-up

input_select:
  lade_modus:                         # -> Helfer: aktueller Lade-Modus
    name: "Ladesteuerung Modus"
    icon: mdi:state-machine
    # Genau die Werte, die der Blueprint schreibt. Ein fehlender Wert laesst
    # input_select.select_option scheitern, ohne dass der Blueprint es merkt.
    options:
      - normal
      - blockade
      - peak_shaving
      - wp_sperre
      - top_balancing
      - fall_b_max
      - nacht
      # Wird derzeit von keinem Zweig gesetzt. Bleibt fuer eine kuenftige
      # Netzlade-Logik erhalten, damit bestehende Instanzen die Option behalten.
      - zwangsladung
    # Kein "initial:" - das ueberspraenge beim Start die Wiederherstellung und
    # setzte fest "normal". Der Modus ist aber Gedaechtnis: Morgen-Blockade und
    # Fall B erkennen an ihm, dass sie schon laufen. Ohne "initial:" steht ein
    # frisch angelegter Helfer ohnehin auf der ersten Option.

input_text:
  pv_optimizer_log:                   # -> Helfer: Logbuch-Anker
    name: "PV Optimizer Logbuch"
    icon: mdi:math-log
  hausverbrauch_json_profil:          # -> Helfer: Verbrauchsprofil (JSON)
    name: "Hausverbrauch Profil JSON"
    max: 255
    icon: mdi:code-json
  temperatur_json_profil:             # -> Helfer: Temperaturprofil (JSON, optional)
    name: "Temperatur Profil JSON"
    max: 255
    icon: mdi:thermometer-lines
  notstrom_json_profil:               # -> Helfer: Notstromprofil (JSON, optional)
    name: "Notstrom Profil JSON"
    max: 255
    icon: mdi:power-plug-battery
  akku_100_prozent_tage:              # -> Helfer: 100-%-Tage-Liste
    # Muss ein input_text sein: ein Sensor-State kaeme als Python-Repr mit
    # einfachen Quotes zurueck, kein gueltiges JSON.
    name: "Akku 100 Prozent Tage"
    max: 255
    icon: mdi:calendar-check

input_number:
  max_soc_heute:                      # -> Helfer: hoechster SOC heute (%)
    name: "Speicher Tages-Höchstwert SOC"
    min: 0
    max: 100
    step: 0.1
    unit_of_measurement: "%"
    icon: mdi:battery-high
    mode: box
  speicherverlust_gesamt:             # -> Helfer: verschenkte Speicherkapazitaet (kWh)
    name: "Speicherverlust Gesamt-Zähler"
    min: 0
    max: 999999
    step: 0.1
    unit_of_measurement: "kWh"
    icon: mdi:battery-minus
    mode: box
  offener_speicherverlust:            # -> Helfer: offener Speicherverlust-Kandidat (kWh)
    name: "Speicherverlust offener Kandidat"
    min: 0
    max: 1000
    step: 0.01
    unit_of_measurement: "kWh"
    icon: mdi:battery-clock
    mode: box
  halten_bezug:                       # -> Helfer: Netzbezug waehrend Haltephase (kWh)
    # Laeuft nachts auf, solange die Entlade-Untergrenze die Batterie haelt;
    # abends als Speicherverlust verbucht (wenn die Batterie voll wurde) und genullt.
    name: "Netzbezug während Haltephase"
    min: 0
    max: 1000
    step: 0.001
    unit_of_measurement: "kWh"
    icon: mdi:transmission-tower-import
    mode: box

timer:
  # restore ueberall: Ohne das faellt ein laufender Timer beim Neustart aus, und
  # der Zweig, den er absichert, sieht einen Zustand, den es nicht mehr gibt.
  zellausgleich_nachlauf:             # -> Timer: Zellausgleich-Nachlauf
    name: "Zellausgleich Nachlauf"
    icon: mdi:timer-sand
    restore: true
  peak_shaving_hold:                  # -> Timer: Peak-Shaving Hold
    name: "Peak Shaving Hold"
    icon: mdi:timer-flash
    restore: true
  # Nicht nur fuer die Waermepumpe: Solange dieser Timer laeuft, hebt die
  # Lastspitzen-Kappung den Ladestrom nicht an. Eine eigene Automation darf ihn
  # fuer jeden grossen Verbraucher starten.
  anlaufphase_grossverbraucher:       # -> Timer: Anlaufphase Großverbraucher
    name: "Anlaufphase Großverbraucher"
    icon: mdi:timer-sand
    restore: true
  wp_boost:                           # -> Timer: WP-Laufzeit
    name: "Wärmepumpe PV-Boost Dauer"
    icon: mdi:timer-star
    restore: true

utility_meter:
  # Die drei Halbstunden-Zaehler tragen bewusst KEIN "cycle": Der Blueprint nullt
  # sie selbst alle 30 Minuten. Ein eigener Zyklus setzte den Zaehler genau auf
  # die Sekunde zurueck, in der der Lauf ihn ausliest - der Slot vor dem Reset
  # lernte dann eine 0 und zoege sich ueber den Mittelwert Nacht fuer Nacht
  # weiter nach unten.
  hausverbrauch_halbstuendlich:       # -> Hausverbrauch halbstuendlich (kWh)
    source: sensor.<HIER EINTRAGEN>   # Tageszaehler Hausverbrauch, kWh, steigend
    name: "Hausverbrauch Halbstündlich"
    net_consumption: false
    delta_values: false
  # Nur mit Wallbox (Sektion 11): je Ladepunkt ein Zaehler ueber dessen Ladeenergie,
  # vom Blueprint zusammen mit dem Hausverbrauch-Zaehler genullt. Beide im Feld
  # "Wallbox-Ladung halbstuendlich" auswaehlen. Zum Nutzen einkommentieren und
  # die Quelle eintragen - ein stehengebliebener Platzhalter laesst Home
  # Assistant die ganze utility_meter-Gruppe verwerfen, auch den Hausverbrauch.
  # wallbox_1_halbstuendlich:
  #   source: sensor.<HIER EINTRAGEN>   # evcc Ladepunkt 1 "Charge Total Import", kWh, steigend
  #   name: "Wallbox 1 Halbstündlich"
  #   net_consumption: false
  #   delta_values: false
  # wallbox_2_halbstuendlich:
  #   source: sensor.<HIER EINTRAGEN>   # evcc Ladepunkt 2 "Charge Total Import"
  #   name: "Wallbox 2 Halbstündlich"
  #   net_consumption: false
  #   delta_values: false
  # Notstromkreis (optional): Energie am Load-UPS-Ausgang je Halbstunde aus dem
  # Riemann-Sensor unten; der Blueprint nullt den Zaehler alle 30 Minuten.
  # Zusammen mit dem Integrations-Sensor weiter unten einkommentieren.
  # notstromlast_halbstuendlich:      # -> Notstromlast halbstuendlich (kWh, optional)
  #   source: sensor.notstromlast_energie
  #   name: "Notstromlast Halbstündlich"
  #   net_consumption: false
  #   delta_values: false
  # Auswertung des Verlust-Zaehlers nach Zeitraum, fuer das Dashboard.
  speicherverlust_heute:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Heute"
    cycle: daily
  speicherverlust_woche:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Diese Woche"
    cycle: weekly
  speicherverlust_monatlich:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Monatlich"
    cycle: monthly
  speicherverlust_jahr:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Dieses Jahr"
    cycle: yearly

template:
  - binary_sensor:
      # "Eingriff" = der Ladestrom steht bei Tag unter dem Maximum. Grundlage
      # fuer die Eingriffsdauer in der Diagnose-Meldung am Tagesende.
      - name: "Ladesteuerung Eingriff Aktiv"
        unique_id: "optimizer_binary_intervention_active"
        icon: mdi:flash-alert
        state: >
          {% set maximum = 350 %}                                        {# Standard; nur aendern, wenn der Blueprint-Input "Maximaler Ladestrom" abweicht #}
          {% set limit = states('number.<HIER EINTRAGEN>') | float(maximum) %}  {# Stellgroesse max. Ladestrom #}
          {{ limit < maximum and is_state('sun.sun', 'above_horizon') }}
sensor:
  # Notstromkreis (optional): der Deye liefert am Load-UPS-Ausgang nur Leistung,
  # die Energie entsteht hier als Riemann-Summe (W -> kWh). Zum Nutzen
  # einkommentieren, zusammen mit dem Zaehler oben.
  # - platform: integration
  #   source: sensor.<HIER EINTRAGEN>   # Deye "Load UPS Power" (W)
  #   name: "Notstromlast Energie"
  #   unique_id: "optimizer_sensor_notstromlast_energie"
  #   unit_prefix: k
  #   round: 3
  #   method: left
  - platform: history_stats           # -> Diagnose: Eingriffsdauer heute
    name: "Ladesteuerung Eingriff Dauer Heute"
    unique_id: "optimizer_sensor_intervention_duration_today"
    entity_id: binary_sensor.ladesteuerung_eingriff_aktiv
    state: "on"
    type: time
    start: "{{ now().replace(hour=0, minute=0, second=0) }}"
    end: "{{ now() }}"

# Zweitmeinung des evcc-Optimizers (Feld "evcc-Optimizer: Adresse"). Adresse und
# Anfrage kommen aus dem Blueprint, hier ist nichts einzutragen. Die Antwort landet
# in der Diagnose-Aufzeichnung (art: optimizer).
rest_command:
  pv_optimizer_zweitmeinung:
    url: "{{ url }}/optimize/charge-schedule"
    method: post
    content_type: "application/json"
    payload: "{{ payload if payload is string else (payload | to_json) }}"
    timeout: 20
