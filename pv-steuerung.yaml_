# ==============================================================================
# MASTER-LADESTEUERUNG: HELFER-PACKAGE (Vorlage)
#
# Diese Datei ist eine VORLAGE, kein fertiges Package. Vor dem Einsatz an
# einem Standort sind die mit <HIER EINTRAGEN> markierten Stellen anzupassen:
#
#   1. utility_meter.hausverbrauch_halbstuendlich.source
#        -> der Tageszaehler des Hausverbrauchs (kWh, steigend). Der Blueprint
#           nullt diesen Zaehler selbst alle 30 Minuten; der "cycle: daily"
#           ist nur die Sicherung fuer den Fall, dass ein Lauf ausfaellt.
#   2. binary_sensor "Ladesteuerung Eingriff Aktiv"
#        -> die number-Entitaet des maximalen Ladestroms und deren Maximalwert
#           (derselbe Wert wie der Blueprint-Input "Maximaler Ladestrom").
#
# Alles andere ist standortunabhaengig. Nach dem Einbinden ueber packages:
# sind die Entitaeten den Blueprint-Inputs zuzuweisen; die Zuordnung steht
# jeweils als Kommentar dabei.
#
# Nicht enthalten ist der Schatten-BMS-Sensor (Blueprint-Input "Schatten-BMS:
# SOC-Sensor"). Er rechnet den Ladestand aus den Lade-/Entladezaehlern und den
# beiden Tara-Werten unten und muss das Attribut raw_drift_soc liefern; er
# gehoert zur Wechselrichter-Anbindung des Standorts, nicht in dieses Package.
#
# Optional: Diagnose-Aufzeichnung. Existiert notify.pv_optimizer_aufzeichnung,
# haengt der Blueprint jede halbe Stunde eine JSON-Zeile mit allen Eingangs-
# werten an - ohne diese Entitaet passiert nichts. Sie laesst sich NICHT per
# YAML anlegen (die File-Integration kennt nur noch Config-Entries), sondern
# nur ueber die Oberflaeche:
#   1. Einstellungen -> Geraete & Dienste -> Integration hinzufuegen -> "File"
#      -> Benachrichtigungsdienst, Dateipfad
#      /config/www/pv_optimizer_aufzeichnung.jsonl, Zeitstempel AUS.
#      (/config/www ist standardmaessig freigegeben, kein allowlist-Eintrag.)
#   2. Einstellungen -> Entitaeten -> die neue notify-Entitaet -> Zahnrad ->
#      Entitaets-ID auf notify.pv_optimizer_aufzeichnung aendern.
# Download im Browser unter /local/pv_optimizer_aufzeichnung.jsonl (ohne
# Anmeldung erreichbar, ca. 0,7 MB je Tag); die Datei gehoert nach tests/fixtures/.
# ==============================================================================

input_boolean:
  batterie_heute_voll:                # -> Helfer: Batterie war heute voll
    name: "Batterie heute voll"
    icon: mdi:battery-check
  blockade_heute_beendet:             # -> Helfer: Morgen-Blockade heute beendet
    name: "Morgen-Blockade heute beendet"
    icon: mdi:weather-sunset-up

input_select:
  lade_modus:                         # -> Helfer: aktueller Lade-Modus
    name: "Ladesteuerung Modus"
    icon: mdi:state-machine
    # Genau die Werte, die der Blueprint schreibt. Ein fehlender Wert laesst
    # input_select.select_option scheitern, ohne dass der Blueprint es merkt.
    options:
      - normal
      - blockade
      - peak_shaving
      - wp_sperre
      - top_balancing
      - fall_b_max
      - nacht
    initial: normal

input_text:
  pv_optimizer_log:                   # -> Helfer: Logbuch-Anker
    name: "PV Optimizer Logbuch"
    icon: mdi:math-log
  hausverbrauch_json_profil:          # -> Helfer: Verbrauchsprofil (JSON)
    name: "Hausverbrauch Profil JSON"
    max: 255
    icon: mdi:code-json
  akku_100_prozent_tage:              # -> Helfer: 100-%-Tage-Liste
    # Muss ein input_text sein: ein Sensor-State kaeme als Python-Repr mit
    # einfachen Quotes zurueck, kein gueltiges JSON.
    name: "Akku 100 Prozent Tage"
    max: 255
    icon: mdi:calendar-check

input_number:
  max_soc_heute:                      # -> Helfer: hoechster SOC heute (%)
    name: "Speicher Tages-Höchstwert SOC"
    min: 0
    max: 100
    step: 0.1
    unit_of_measurement: "%"
    icon: mdi:battery-high
    mode: box
  speicherverlust_gesamt:             # -> Helfer: verschenkte Speicherkapazitaet (kWh)
    name: "Speicherverlust Gesamt-Zähler"
    min: 0
    max: 999999
    step: 0.1
    unit_of_measurement: "kWh"
    icon: mdi:battery-minus
    mode: box
  offener_speicherverlust:            # -> Helfer: offener Speicherverlust-Kandidat (kWh)
    name: "Speicherverlust offener Kandidat"
    min: 0
    max: 1000
    step: 0.01
    unit_of_measurement: "kWh"
    icon: mdi:battery-clock
    mode: box
  schatten_bms_tare_geladen:          # -> Schatten-BMS: Tare Ladezaehler (kWh)
    name: "Schatten-BMS Tara geladen"
    min: 0
    max: 9999999
    step: 0.001
    unit_of_measurement: "kWh"
    icon: mdi:battery-arrow-up
    mode: box
  schatten_bms_tare_entladen:         # -> Schatten-BMS: Tare Entladezaehler (kWh)
    name: "Schatten-BMS Tara entladen"
    min: 0
    max: 9999999
    step: 0.001
    unit_of_measurement: "kWh"
    icon: mdi:battery-arrow-down
    mode: box

timer:
  zellausgleich_nachlauf:             # -> Timer: Zellausgleich-Nachlauf
    name: "Zellausgleich Nachlauf"
    icon: mdi:timer-sand
  peak_shaving_hold:                  # -> Timer: Peak-Shaving Hold
    name: "Peak Shaving Hold"
    icon: mdi:timer-flash
  wp_anlaufphase:                     # -> Timer: WP-Anlaufphase
    name: "Wärmepumpe Anlaufphase"
    icon: mdi:timer-sand
  wp_boost:                           # -> Timer: WP-Laufzeit
    name: "Wärmepumpe PV-Boost Dauer"
    icon: mdi:timer-star

utility_meter:
  hausverbrauch_halbstuendlich:       # -> Hausverbrauch halbstuendlich (kWh)
    source: sensor.<HIER EINTRAGEN>   # Tageszaehler Hausverbrauch, kWh, steigend
    name: "Hausverbrauch Halbstündlich"
    cycle: daily
    net_consumption: false
    delta_values: false
  # Auswertung des Verlust-Zaehlers nach Zeitraum, fuer das Dashboard.
  speicherverlust_heute:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Heute"
    cycle: daily
  speicherverlust_woche:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Diese Woche"
    cycle: weekly
  speicherverlust_monatlich:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Monatlich"
    cycle: monthly
  speicherverlust_jahr:
    source: input_number.speicherverlust_gesamt
    name: "Speicherverlust Dieses Jahr"
    cycle: yearly

template:
  - binary_sensor:
      # "Eingriff" = der Ladestrom steht bei Tag unter dem Maximum. Grundlage
      # fuer die Eingriffsdauer in der Diagnose-Meldung am Tagesende.
      - name: "Ladesteuerung Eingriff Aktiv"
        unique_id: "optimizer_binary_intervention_active"
        icon: mdi:flash-alert
        state: >
          {% set maximum = 350 %}                                        {# <HIER EINTRAGEN>: Maximaler Ladestrom #}
          {% set limit = states('number.<HIER EINTRAGEN>') | float(maximum) %}  {# Stellgroesse max. Ladestrom #}
          {{ limit < maximum and is_state('sun.sun', 'above_horizon') }}

sensor:
  - platform: history_stats           # -> Diagnose: Eingriffsdauer heute
    name: "Ladesteuerung Eingriff Dauer Heute"
    unique_id: "optimizer_sensor_intervention_duration_today"
    entity_id: binary_sensor.ladesteuerung_eingriff_aktiv
    state: "on"
    type: time
    start: "{{ now().replace(hour=0, minute=0, second=0) }}"
    end: "{{ now() }}"
